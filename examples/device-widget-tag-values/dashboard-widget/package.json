    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.7.0"
  },
  "devDependencies": {
    "@rspack/core": "^1.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "serve": "^14.2.5",
