{
    "on_message_processing": {
        "name": "on_message_processing",
        "display_name": "On Message Processing",
        "type": "PRO",
        "visibility": "PRI",
        "allow_many": false,
        "description": "Processes example telemetry messages into tags and a Doover UI.",
        "long_description": "README.md",
        "depends_on": [],
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 300,
            "Handler": "src.on_message_processing.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "dv_proc_subscriptions": {
                    "title": "Subscription",
                    "x-name": "dv_proc_subscriptions",
                    "x-hidden": false,
                    "type": [
                        "array",
                        "null"
                    ],
                    "x-required": false,
                    "description": "A list of channels to subscribe to.",
                    "default": [
                        "on_example_data"
                    ],
                    "x-position": 0,
                    "x-advanced": true,
                    "items": {
                        "title": "Channel Subscription",
                        "x-name": "dv_proc_subscription",
                        "x-hidden": false,
                        "type": "string",
                        "x-required": true,
                        "description": "The name of the channel to subscribe to"
                    }
                },
                "measurement_field": {
                    "title": "Measurement Field",
                    "x-name": "measurement_field",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "JSON field containing the numeric value to process.",
                    "default": "value",
                    "x-position": 1
                },
                "value_offset": {
                    "title": "Value Offset",
                    "x-name": "value_offset",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Optional calibration offset added to each measurement.",
                    "default": 0.0,
                    "x-position": 2
                },
                "offline_after_minutes": {
                    "title": "Offline After (minutes)",
                    "x-name": "offline_after_minutes",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Mark the source offline if another message does not arrive in time.",
                    "default": 60.0,
                    "x-position": 3,
                    "minimum": 1.0
                },
                "dv_app_position": {
                    "title": "Position",
                    "x-name": "dv_app_position",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                    "default": 100,
                    "x-position": 4,
                    "minimum": 0
                },
                "dv_app_default_open": {
                    "title": "Default Open",
                    "x-name": "dv_app_default_open",
                    "x-hidden": true,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Whether the application is default open in the UI. By default this is not set - which makes it dynamic on the number of apps installed.",
                    "default": null,
                    "x-position": 5
                }
            },
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "measurement": {
                    "name": "measurement",
                    "type": "uiVariable",
                    "displayString": "Measurement",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "varType": "float",
                    "currentValue": "$tag.app().measurement:number:null",
                    "decPrecision": 2,
                    "ranges": [
                        {
                            "min": 0,
                            "max": 25,
                            "colour": "blue",
                            "show_on_graph": true,
                            "label": "Low"
                        },
                        {
                            "min": 25,
                            "max": 75,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "Normal"
                        },
                        {
                            "min": 75,
                            "max": 100,
                            "colour": "yellow",
                            "show_on_graph": true,
                            "label": "High"
                        }
                    ],
                    "live": true
                },
                "status": {
                    "name": "status",
                    "type": "uiVariable",
                    "displayString": "Status",
                    "showActivity": true,
                    "position": 52,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().status:string:\"unknown\""
                },
                "source_time": {
                    "name": "source_time",
                    "type": "uiVariable",
                    "displayString": "Source Time",
                    "showActivity": true,
                    "position": 53,
                    "hidden": false,
                    "varType": "time",
                    "currentValue": "$tag.app().source_time:string:null"
                },
                "last_processed": {
                    "name": "last_processed",
                    "type": "uiVariable",
                    "displayString": "Last Processed",
                    "showActivity": true,
                    "position": 54,
                    "hidden": false,
                    "varType": "time",
                    "currentValue": "$tag.app().last_processed_at:string:null"
                }
            }
        }
    }
}