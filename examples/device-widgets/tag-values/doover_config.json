{
    "tag_values_widget": {
        "name": "tag_values_widget",
        "display_name": "Tag Values Widget",
        "type": "PRO",
        "visibility": "PRI",
        "allow_many": false,
        "description": "Displays every tag value on the device where it is installed.",
        "long_description": "README.md",
        "depends_on": [],
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "build_widget_command": "npm --prefix dashboard-widget run build",
        "widget": "dashboard-widget/assets/TagValuesWidget.js",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 60,
            "Handler": "src.tag_values_widget.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "dv_app_position": {
                    "title": "Position",
                    "x-name": "dv_app_position",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                    "default": 100,
                    "x-position": 0,
                    "minimum": 0
                }
            },
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().interpreter_hidden:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": true,
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "TagValuesWidget": {
                    "name": "TagValuesWidget",
                    "type": "uiRemoteComponent",
                    "displayString": "Tag Values",
                    "showActivity": true,
                    "componentUrl": "$config.app().dv_widget_url",
                    "position": 51,
                    "hidden": false,
                    "children": {},
                    "scope": "TagValuesWidget",
                    "module": "./TagValuesWidget"
                }
            }
        }
    }
}