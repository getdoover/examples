{
    "fleet_overview_dashboard": {
        "name": "fleet_overview_dashboard",
        "display_name": "Fleet Overview Dashboard",
        "type": "PRO",
        "visibility": "PRI",
        "allow_many": false,
        "description": "Dashboard widget summarising live telemetry across permitted devices.",
        "long_description": "README.md",
        "depends_on": [],
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "build_widget_command": "npm run build",
        "widget": "assets/FleetOverviewDashboardWidget.js",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 60,
            "Handler": "src.fleet_overview_dashboard.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "dv_proc_extended_permissions": {
                    "title": "Devices",
                    "x-name": "dv_proc_extended_permissions",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "description": "Give Permission to access devices.",
                    "x-position": 0,
                    "properties": {
                        "devices": {
                            "title": "Devices",
                            "x-name": "devices",
                            "x-hidden": false,
                            "type": "array",
                            "x-required": true,
                            "description": "List of devices to grant extended permissions to.",
                            "x-position": 1,
                            "items": {
                                "title": "Device",
                                "x-name": "device",
                                "x-hidden": false,
                                "format": "doover-resource-device",
                                "type": "string",
                                "x-required": true,
                                "description": "Device ID",
                                "pattern": "\\d+"
                            }
                        },
                        "groups": {
                            "title": "Groups",
                            "x-name": "groups",
                            "x-hidden": false,
                            "type": "array",
                            "x-required": true,
                            "description": "List of groups to grant permissions to.",
                            "x-position": 2,
                            "items": {
                                "title": "Group",
                                "x-name": "group",
                                "x-hidden": false,
                                "format": "doover-resource-group",
                                "type": "string",
                                "x-required": true,
                                "description": "Group ID",
                                "pattern": "\\d+"
                            }
                        },
                        "apps_installed": {
                            "title": "Apps Installed",
                            "x-name": "apps_installed",
                            "x-hidden": false,
                            "type": "array",
                            "x-required": true,
                            "description": "Permission will be given to any devices which have any of the apps listed installed.",
                            "x-position": 3,
                            "items": {
                                "title": "Application",
                                "x-name": "application",
                                "x-hidden": false,
                                "format": "doover-resource-application",
                                "type": "string",
                                "x-required": true,
                                "description": "Application"
                            }
                        },
                        "all_devices": {
                            "title": "All Devices",
                            "x-name": "all_devices",
                            "x-hidden": false,
                            "type": [
                                "boolean",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Permission will be given for all devices in this organisation. This is a very far-reaching permission to grant!",
                            "default": false,
                            "x-position": 4
                        },
                        "dd_permissions": {
                            "title": "Data Permissions",
                            "x-name": "dd_permissions",
                            "x-hidden": true,
                            "format": "dd_permissions",
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "description": "Permissions granted on each device this app has access to. Leave empty to grant all permissions. Set to 0 to grant none \u2014 for an app that only needs the device map, not access to the devices.",
                            "default": null,
                            "x-position": 5
                        }
                    },
                    "additionalElements": true,
                    "required": [
                        "devices",
                        "groups",
                        "apps_installed"
                    ],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false,
                    "x-extraDeviceFields": [
                        "group__id",
                        "group__name",
                        "id",
                        "name",
                        "display_name"
                    ]
                },
                "dv_app_position": {
                    "title": "Position",
                    "x-name": "dv_app_position",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                    "default": 100,
                    "x-position": 1,
                    "minimum": 0
                }
            },
            "additionalElements": true,
            "required": [
                "dv_proc_extended_permissions"
            ]
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().interpreter_hidden:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": true,
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "FleetOverview": {
                    "name": "FleetOverview",
                    "type": "uiRemoteComponent",
                    "displayString": "Fleet Overview",
                    "showActivity": true,
                    "componentUrl": "$config.app().dv_widget_url",
                    "position": 51,
                    "hidden": false,
                    "children": {},
                    "scope": "FleetOverviewDashboardWidget",
                    "module": "./FleetOverviewDashboardWidget",
                    "app_key": "$config.app().APP_KEY"
                }
            }
        }
    }
}