{
    "docker_app_template": {
        "name": "docker_app_template",
        "display_name": "Docker App Template",
        "type": "DEV",
        "visibility": "PRI",
        "allow_many": true,
        "description": "Minimal no-op Doover Docker app.",
        "long_description": "README.md",
        "depends_on": [],
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "image_name": "ghcr.io/YOUR_GITHUB_ORG/docker-app-template:main",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {},
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {}
        }
    }
}