{
    "processor_template": {
        "name": "processor_template",
        "display_name": "Processor Template",
        "type": "PRO",
        "visibility": "PRI",
        "allow_many": false,
        "description": "Minimal no-op Doover processor.",
        "long_description": "README.md",
        "depends_on": [],
        "export_config_command": "export-config",
        "export_ui_command": "export-ui",
        "lambda_config": {
            "Environment": {},
            "Runtime": "python3.13",
            "Timeout": 300,
            "Handler": "src.processor_template.handler",
            "MemorySize": 128,
            "Architectures": [
                "arm64"
            ]
        },
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {},
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {}
        }
    }
}